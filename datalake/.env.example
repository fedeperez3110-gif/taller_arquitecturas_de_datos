# Copia este archivo como .env (en la EC2) y completa los valores.
# Los 4 primeros los imprime: terraform -chdir=infra/terraform output env_values
# NO pongas aquí AWS_ACCESS_KEY_ID ni AWS_SECRET_ACCESS_KEY: la EC2 usa su rol IAM.

# --- Data lake ---
DATALAKE_BUCKET=rss-datalake-123456789012-us-east-2
AWS_DEFAULT_REGION=us-east-2
GLUE_DATABASE=rss_datalake
ATHENA_WORKGROUP=rss-datalake

# --- Airflow ---
# En la EC2 obtén tu UID con:  id -u
AIRFLOW_UID=1000
_AIRFLOW_WWW_USER_USERNAME=admin
_AIRFLOW_WWW_USER_PASSWORD=cambia-esta-clave
# Genera ambas con:
#   FERNET_KEY:  openssl rand -base64 32 | tr '+/' '-_'
#   SECRET_KEY:  openssl rand -hex 32
AIRFLOW__CORE__FERNET_KEY=
AIRFLOW__WEBSERVER__SECRET_KEY=
