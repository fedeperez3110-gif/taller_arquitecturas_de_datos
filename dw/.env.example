# Copia este archivo como dw/.env EN LA EC2 (~/dw/.env). Los valores los imprime:
#   ./infra/dw.sh env        (en tu computador)
# Sin contraseñas: MySQL, DocumentDB y Redshift se leen de AWS Secrets Manager con el rol de la EC2.
DW_BUCKET=ecommerce-dw-123456789012-us-east-2
DW_REGION=us-east-2
DW_MYSQL_SECRET=ecommerce-dw/mysql
DW_DOCDB_SECRET=ecommerce-dw/docdb
DW_REDSHIFT_SECRET=ecommerce-dw/redshift
DW_REDSHIFT_IAM_ROLE=arn:aws:iam::123456789012:role/ecommerce-dw-redshift-copy-role
